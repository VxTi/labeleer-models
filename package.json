{
  "name": "@labeleer/translation-dataset-transformers",
  "version": "1.0.4",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/definitions.d.ts",
      "require": "./dist/index.js"
    }
  },
  "private": false,
  "type": "module",
  "description": "Utility parser methods used by all Labeleer tools",
  "author": "Luca Warmenhoven",
  "license": "ISC",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --p tsconfig.release.json && tsc-alias -p tsconfig.release.json",
    "prepublishOnly": "npm run clean; npm run test && npm run build;",
    "test": "vitest run",
    "test:update": "vitest run -u",
    "lint": "eslint --fix \"./src/**/*.ts\" --cache --max-warnings 0",
    "sanity": "npm run lint; npm run test; tsc --noEmit; npm run clean",
    "clean": "rm -rf ./dist tsconfig.release.tsbuildinfo"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@types/gettext-parser": "^8.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jiti": "^2.6.1",
    "prettier": "^3.6.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.3.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.14"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.2",
    "gettext-parser": "^8.0.0",
    "jszip": "^3.10.1",
    "lodash-es": "^4.17.22",
    "yaml": "^2.8.2",
    "zod": "^4.2.1"
  }
}
